# GESIT local credentials template (NFR-4). Copy to .env and fill in; .env is gitignored.
# Variable names only. Never put a real value in this file.

# SAP AI Core service key: SAP-RPT-1.6 (integrations/sap/rpt_client.py) and the
# Gen AI Hub reasoning models (agents/llm.py, integrations/sap/aicore.py)
AICORE_AUTH_URL=
AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
AICORE_BASE_URL=
AICORE_RESOURCE_GROUP=default

# Gen AI Hub reasoning model, agent reasoning and explanations (agents/llm.py)
# Optional: model name (default gpt-5.4), temperature (capped at 0.2)
GESIT_LLM_MODEL=
GESIT_LLM_TEMPERATURE=
# Optional: fallback models, comma separated. Empty = anthropic--claude-4.6-sonnet, none = no fallback.
# Used only when the model before it is not deployed, rate limited, overloaded or out of output tokens.
GESIT_LLM_FALLBACK_MODEL=

# SAP-RPT-1.6 deployment on SAP AI Core, delay prediction
SAP_RPT_DEPLOYMENT_ID=
# Development alternative: public RPT API token instead of the AI Core variables
SAP_RPT_API_TOKEN=
# Optional: force aicore or playground; any other value (for example none) means no SAP-RPT
SAP_RPT_MODE=

# Supplier Evaluation: proposed rule, see docs/prd_change_proposals.md (default true)
GESIT_EXCLUDE_FLAGGED_SUPPLIERS=

# Integrity Guard: override log, one JSON line per override (default ./decision_log.jsonl, gitignored)
DECISION_LOG_PATH=

# Supervisor: plan log, one JSON line per run with seconds per step (default plan_log.jsonl
# next to the decision log, gitignored)
PLAN_LOG_PATH=
# PO store: GESIT's draft and pending POs, kept between processes for the manager's approval
# (default po_store.json next to the decision log, gitignored)
PO_STORE_PATH=

# HTTP API for Joule (integrations/api): the X-API-Key value. Required, the API does not start
# without it. On Cloud Foundry: cf set-env gesit-api GESIT_API_KEY <value>
GESIT_API_KEY=
