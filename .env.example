# GESIT local credentials template (NFR-4). Copy to .env and fill in; .env is gitignored.
# Variable names only. Never put a real value in this file.

# Gemini Flash, agent reasoning and explanations (agents/llm.py)
GEMINI_API_KEY=
# Optional: fixed model id (default gemini-3.5-flash), temperature (capped at 0.2)
GESIT_LLM_MODEL=
GESIT_LLM_TEMPERATURE=
# Optional: fallback models, comma separated. Empty = gemini-2.5-flash, none = no fallback.
# Used only when the model before it is out of quota or runs out of output tokens twice.
GESIT_LLM_FALLBACK_MODEL=

# SAP-RPT-1.6 on SAP AI Core, delay prediction (integrations/sap/rpt_client.py)
AICORE_AUTH_URL=
AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
AICORE_BASE_URL=
AICORE_RESOURCE_GROUP=default
SAP_RPT_DEPLOYMENT_ID=
# Development alternative: public RPT API token instead of the AI Core variables
SAP_RPT_API_TOKEN=
# Optional: force aicore or playground; any other value (for example none) means no SAP-RPT
SAP_RPT_MODE=

# Supplier Evaluation: proposed rule, see docs/prd_change_proposals.md (default true)
GESIT_EXCLUDE_FLAGGED_SUPPLIERS=
